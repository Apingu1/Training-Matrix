APP_NAME=Eaststone Training Matrix
APP_VERSION=0.2.1
APP_ENV=production
APP_PORT=8090
APP_HEALTH_PORT=18090
TZ=Europe/London

POSTGRES_DB=training_matrix
POSTGRES_USER=training_matrix
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
DATABASE_URL=postgresql+psycopg://training_matrix:replace_with_a_long_random_database_password@db:5432/training_matrix

# Required. The application refuses to start with a missing or weak secret.
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_MINUTES=480
SESSION_IDLE_MINUTES=15
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_temporary_password

# Windows examples use forward slashes for Docker Desktop compatibility.
DOCUMENTS_HOST_PATH=C:/Eaststone/Controlled Documents
BACKUP_HOST_PATH=C:/Eaststone/Training Matrix Backups
TLS_CERT_HOST_PATH=C:/ProgramData/Eaststone/TrainingMatrix/tls
DOCUMENT_ROOT=/controlled-documents
BACKUP_ROOT=/backups
DOCUMENT_CACHE_ROOT=/document-cache
RUNTIME_ROOT=/runtime

BACKUP_TIME=02:30
BACKUP_TIMEZONE=Europe/London
BACKUP_RETENTION_DAYS=30
